---
import Layout from './Layout.astro';
import { LEGAL_UPDATED } from '../lib/site';

interface Props {
  title: string;
  description: string;
  heading: string;
  showUpdated?: boolean;
}

const { title, description, heading, showUpdated = true } = Astro.props;
---
<Layout title={title} description={description} noIndex={true}>
  <div class="page-head">
    <div class="wrap">
      <nav class="crumb" aria-label="Migas de pan">
        <a href="/">Inicio</a>
        <span class="sep" aria-hidden="true">/</span>
        <span class="cur">{heading}</span>
      </nav>
      <h1 class="page-title">
        {heading}
      </h1>
    </div>
  </div>
  <div class="page-content">
    <div class="wrap">
      <div class="prose">
        {showUpdated && <p><em>Última actualización: {LEGAL_UPDATED}</em></p>}
        <slot />
      </div>
    </div>
  </div>
</Layout>
