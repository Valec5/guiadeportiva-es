---
import type { ProductItem } from '../lib/seo';

// Price, availability and rating are optional on purpose: only pass them when they come
// from a live source (e.g. Amazon PA-API) or a real rating. Static or invented values
// break Amazon Associates rules and Google's structured-data policies.
interface Product extends ProductItem {
  price?: number;
  availability?: 'InStock' | 'OutOfStock' | 'PreOrder';
  rating?: { value: number; count: number; best?: number };
}

interface Props {
  products: Product[];
  pageUrl: string;
}

const { products, pageUrl } = Astro.props;

const schema = {
  '@context': 'https://schema.org',
  '@graph': products.map((p, i) => ({
    '@type': 'Product',
    '@id': `${pageUrl}#producto-${i + 1}`,
    name: p.name,
    ...(p.brand && { brand: { '@type': 'Brand', name: p.brand } }),
    ...(p.description && { description: p.description }),
    ...(p.url && {
      offers: {
        '@type': 'Offer',
        url: p.url,
        priceCurrency: 'EUR',
        ...(p.price !== undefined && { price: p.price }),
        ...(p.availability && { availability: `https://schema.org/${p.availability}` }),
      },
    }),
    ...(p.rating && {
      aggregateRating: {
        '@type': 'AggregateRating',
        ratingValue: p.rating.value,
        reviewCount: p.rating.count,
        bestRating: p.rating.best ?? 5,
      },
    }),
  })),
};
---
{products.length > 0 && <script type="application/ld+json" set:html={JSON.stringify(schema)} />}
