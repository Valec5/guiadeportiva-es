---
interface Category {
  slug: string;
  label: string;
  description: string;
  count: number;
}

interface Props {
  categories: Category[];
}

const { categories } = Astro.props;

---
<section class="cat-section">
  <div class="wrap">
    <div class="sec-head">
      <h2>¿Qué tipo de zapatilla buscas?</h2>
    </div>
    <div class="cat-grid">
      {categories.map(cat => (
        <a href={`/${cat.slug}/`} class="cat-card">
          <h3>{cat.label}</h3>
          <p>{cat.description}</p>
          <div class="cat-count">{cat.count} guías</div>
        </a>
      ))}
    </div>
  </div>
</section>
