---
// One-line technical summary under a product heading, in the data face (JetBrains Mono), so readers can
// compare models at a glance. Every value must come from the article itself (its comparison table or text):
// pieces that are missing are simply left out, and with no pieces at all nothing renders.
// Never pass prices, ratings or launch years.
interface Props {
  weight?: string;   // "311 g" (add the size only when it differs from the article's standard)
  drop?: string;     // "10 mm"
  stack?: string;    // "32/27 mm" (heel/forefoot)
  midsole?: string;  // "FF Blast+ Eco"
  category?: string; // pisada o uso: "pronación moderada", "neutra", "trail técnico"…
  extra?: string[];  // datos del nicho: tacos, suela, calas, plataforma…
}

const { weight, drop, stack, midsole, category, extra = [] } = Astro.props;
const clean = (v?: string) => (v && !/^(n\/?a|—|-)$/i.test(v.trim()) ? v.trim() : undefined);

const parts = [
  clean(weight),
  clean(drop) && `drop ${clean(drop)}`,
  clean(stack) && `stack ${clean(stack)}`,
  clean(midsole),
  ...extra.map(clean),
  clean(category),
].filter(Boolean) as string[];
---
{parts.length > 0 && (
  <p class="product-specs">
    <span class="visually-hidden">Ficha técnica: </span>
    {parts.map((p, i) => (
      <>
        {i > 0 && <span class="sep" aria-hidden="true">·</span>}
        <span class="piece">{p}</span>
      </>
    ))}
  </p>
)}

<style>
  .product-specs {
    font-family: var(--mono);
    font-size: 13px;
    line-height: 1.5;
    font-feature-settings: "tnum";
    color: var(--ink-faint);
    margin: -0.25rem 0 1rem 0;
    max-width: none;
  }
  .piece { white-space: nowrap; }
  .sep { color: var(--line-strong); margin: 0 0.5em; }
  .visually-hidden {
    position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px;
    overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; border: 0;
  }
  @media (max-width: 560px) {
    .product-specs { font-size: 12px; }
  }
</style>
